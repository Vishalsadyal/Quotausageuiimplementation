MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=replace_with_resend_api_key
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@careerpilot.com
MAIL_FROM_NAME=CareerPilot
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
# For local dev only (self-signed certificate chain errors), set to false.
SMTP_USER=resend
SMTP_PASS=replace_with_resend_smtp_password
EMAIL_FROM=no-reply@careerpilot.com
OTP_HASH_SECRET=replace_with_long_random_secret
OTP_DEV_BYPASS_MAIL=false
OTP_DEV_SHOW_CODE=false
MAIL_HEALTH_ALLOW_BYPASS=false
BILLING_DEV_MOCK_CHECKOUT=false
MAX_RESUME_FILE_MB=5
JWT_SECRET=replace_with_long_random_jwt_secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ENCRYPTION_KEY=replace_with_32_char_secret_value
WORKER_SECRET=replace_with_worker_secret
AUTO_APPLIER_ROOT=../Auto_job_applier_linkedIn
PYTHON_BIN=python
AUTO_APPLIER_TIMEOUT_SEC=900
AUTO_APPLIER_HEADLESS=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required in production (queue + distributed rate limiting).
UPSTASH_JOB_QUEUE_KEY=careerpilot:auto_apply_jobs
QUOTA_FREE_DAILY=3
QUOTA_PRO_DAILY=50
QUOTA_COACH_DAILY=200
SIGNUP_BONUS_HIRES=300
# Live/Test keys: the admin picks the mode on /admin/payments.
RZP_KEY_ID_TEST=
RZP_KEY_SECRET_TEST=
RZP_WEBHOOK_SECRET_TEST=
RZP_PLAN_PRO_TEST=
RZP_PLAN_CONNECT_TEST=
RZP_PLAN_COACH_TEST=
RZP_KEY_ID_LIVE=
RZP_KEY_SECRET_LIVE=
RZP_WEBHOOK_SECRET_LIVE=
RZP_PLAN_PRO_LIVE=
RZP_PLAN_CONNECT_LIVE=
RZP_PLAN_COACH_LIVE=
BILLING_PORTAL_URL=mailto:billing@careerpilot.com
APP_SITE_URL=https://www.autoapplycv.in
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v23.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerpilot?schema=public
ADMIN_EMAIL=admin@careerpilot.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=CareerPilot Admin
ALLOW_ADMIN_BOOTSTRAP=false
NEXT_PUBLIC_EXTENSION_STORE_URL=
NEXT_PUBLIC_GOOGLE_TAG_ID=
# Optional: Google Tag Manager container id (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_TAG_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5625706421007973
# Only needed if you run the Vite entrypoint (not required for Next.js-only).
VITE_CLARITY_TAG_ID=

# Optional: website assistant chatbot
NEXT_PUBLIC_CHATBOT_ENABLED=true
NEXT_PUBLIC_CHATBOT_POSITION=bottom-right
NEXT_PUBLIC_CHATBOT_TITLE=Ask me
# Use your brand colors (defaults match AutoApply CV site)
NEXT_PUBLIC_CHATBOT_PRIMARY="#6366F1"
NEXT_PUBLIC_CHATBOT_ACCENT="#A855F7"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: receive support chat notifications on your phone via Telegram (free).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: set a secret token and configure it in Telegram webhook "secret_token".
TELEGRAM_WEBHOOK_SECRET=

# ============================================================
# Google OAuth
