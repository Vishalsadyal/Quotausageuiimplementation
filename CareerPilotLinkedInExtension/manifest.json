{
  "manifest_version": 3,
  "name": "AutoApply CV - All-in-One Job Copilot & Outreach Suite",
  "version": "3.1.1",
  "description": "All-in-one job copilot: LinkedIn Easy Apply, Indeed automation, WhatsApp outreach, and live AI interview.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://*.indeed.com/*",
    "https://web.whatsapp.com/*",
    "https://api.whatsapp.com/*",
    "https://wa.me/*",
    "https://mail.google.com/*",
    "https://autoapplycv.in/*",
    "https://www.autoapplycv.in/*",
    "https://autoapplycv.vercel.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "images/*.png",
        "images/*.jpg"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://www.indeed.com/*",
        "https://*.indeed.com/*",
        "https://web.whatsapp.com/*",
        "https://mail.google.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.linkedin.com/jobs/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "src/content_linkedin_wa.js",
        "src/content_linkedin_email.js",
        "src/content_linkedin_commenter.js",
        "src/content_linkedin_hr.js"
      ],
      "css": [
        "src/panel_outreach.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.indeed.com/*",
        "https://*.indeed.com/*"
      ],
      "js": [
        "src/content_indeed.js"
      ],
      "css": [
        "src/panel_indeed.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/content_whatsapp.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/content_gmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://autoapplycv.in/*",
        "https://www.autoapplycv.in/*",
        "https://autoapplycv.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3001/*",
        "http://127.0.0.1:3001/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "src/dashboard-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_title": "AutoApply CV Suite",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
