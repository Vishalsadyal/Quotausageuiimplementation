{
  "manifest_version": 3,
  "name": "AutoApply CV - All-in-One Job Copilot & Outreach Suite",
  "version": "3.4.1",
  "description": "Job copilot: LinkedIn Easy Apply, WhatsApp and email outreach to recruiters, and a live call copilot for Google Meet.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://web.whatsapp.com/*",
    "https://api.whatsapp.com/*",
    "https://wa.me/*",
    "https://mail.google.com/*",
    "https://autoapplycv.in/*",
    "https://www.autoapplycv.in/*",
    "https://autoapplycv.vercel.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "images/*.png",
        "images/*.jpg"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://web.whatsapp.com/*",
        "https://mail.google.com/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.linkedin.com/jobs/*"
      ],
      "js": [
        "src/linkedin/core/dom.js",
        "src/linkedin/core/wait.js",
        "src/linkedin/core/pages.js",
        "src/linkedin/core/job.js",
        "src/linkedin/jobs/01-config.js",
        "src/linkedin/jobs/02-debug-log.js",
        "src/linkedin/jobs/03-submit-pace.js",
        "src/linkedin/jobs/04-debug-badge.js",
        "src/linkedin/jobs/05-job-memory.js",
        "src/linkedin/jobs/06-panel-layout.js",
        "src/linkedin/jobs/07-messaging.js",
        "src/linkedin/jobs/08-answers.js",
        "src/linkedin/jobs/09-apply-button.js",
        "src/linkedin/jobs/10-applied-detection.js",
        "src/linkedin/jobs/11-card-tags.js",
        "src/linkedin/jobs/12-keywords.js",
        "src/linkedin/jobs/13-skip-rules.js",
        "src/linkedin/jobs/14-option-choice.js",
        "src/linkedin/jobs/15-search-url.js",
        "src/linkedin/jobs/16-search-nav.js",
        "src/linkedin/jobs/17-filters.js",
        "src/linkedin/jobs/18-run-control.js",
        "src/linkedin/jobs/19-panel-ui.js",
        "src/linkedin/jobs/20-panel-render.js",
        "src/linkedin/jobs/21-job-cards.js",
        "src/linkedin/jobs/22-modal.js",
        "src/linkedin/jobs/23-question-blocks.js",
        "src/linkedin/jobs/24-modal-buttons.js",
        "src/linkedin/jobs/24-related-answer-groups.js",
        "src/linkedin/jobs/24a-answer-engine.js",
        "src/linkedin/jobs/25-form-fill.js",
        "src/linkedin/jobs/25a-panel-ask.js",
        "src/linkedin/jobs/26-easy-apply-flow.js",
        "src/linkedin/jobs/27-run-cycle.js",
        "src/linkedin/jobs/28-run-loop.js",
        "src/linkedin/jobs/29-init.js"
      ],
      "css": [
        "src/linkedin/jobs/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "src/linkedin/outreach/outreach_ui.js",
        "src/linkedin/outreach/content_linkedin_wa.js",
        "src/linkedin/outreach/content_linkedin_email.js",
        "src/linkedin/outreach/content_linkedin_commenter.js",
        "src/linkedin/outreach/content_linkedin_hr.js"
      ],
      "css": [
        "src/linkedin/outreach/outreach_base.css",
        "src/linkedin/outreach/outreach_wa.css",
        "src/linkedin/outreach/outreach_email.css",
        "src/linkedin/outreach/outreach_comment.css",
        "src/linkedin/outreach/panel_outreach.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/whatsapp/content_whatsapp.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/gmail/content_gmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://autoapplycv.in/*",
        "https://www.autoapplycv.in/*",
        "https://autoapplycv.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3001/*",
        "http://127.0.0.1:3001/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "src/dashboard/dashboard-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/meet/content_meet_copilot.js"
      ],
      "css": [
        "src/meet/panel_meet.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/ui/options.html",
  "action": {
    "default_title": "AutoApply CV Suite",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "linkedin_trackers",
        "enabled": true,
        "path": "src/rules/block-linkedin-trackers.json"
      }
    ]
  },
  "optional_host_permissions": [
    "https://*.doubleclick.net/*",
    "https://*.googletagmanager.com/*",
    "https://*.google-analytics.com/*",
    "https://*.googleadservices.com/*",
    "https://*.googlesyndication.com/*",
    "https://*.demdex.net/*",
    "https://bat.bing.com/*",
    "https://*.trkn.us/*",
    "https://trkn.us/*",
    "https://*.tiqcdn.com/*",
    "https://*.facebook.com/*",
    "https://connect.facebook.net/*"
  ]
}
