{
  "name": "careerpilot-linkedin-extension",
  "version": "3.4.1",
  "private": true,
  "description": "AutoApply CV LinkedIn extension.",
  "scripts": {
    "build": "node tools/probes/build.mjs && node tools/codemap.mjs && vite build",
    "codemap": "node tools/codemap.mjs",
